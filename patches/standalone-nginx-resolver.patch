diff --git a/deploy/standalone/nginx.conf b/deploy/standalone/nginx.conf
index d843fdf5..1bc2cd3c 100644
--- a/deploy/standalone/nginx.conf
+++ b/deploy/standalone/nginx.conf
@@ -4,8 +4,13 @@ server {
   client_max_body_size 20m;
   location = /api/standalone/import { return 404; }
   location = /api/standalone/admin { return 404; }
+  # Look runtime up per request (Docker's DNS, cached 10s): a redeploy that
+  # recreates runtime but not web gives it a new address, and a name resolved
+  # once at startup would send every request to the old one.
+  resolver 127.0.0.11 valid=10s ipv6=off;
   location / {
-    proxy_pass http://runtime:8080;
+    set $runtime http://runtime:8080;
+    proxy_pass $runtime;
     proxy_http_version 1.1;
     proxy_set_header Host $host;
     proxy_set_header X-Real-IP $remote_addr;
